# StudyBridge AI — environment template
#
# Copy to `.env` for LOCAL development only. The deployed site does NOT read
# this file: the Edge Function reads Deno environment variables, which on Qoder
# Sites are provisioned as Site Secrets (see DEPLOYMENT.md).
#
# Never commit a real key. `.env` is listed in .gitignore.

# --------------------------------------------------------------------------
# Credential encryption (required to store BYOK provider keys)
# --------------------------------------------------------------------------
# AES-GCM key used by functions/lib/ai.mjs to encrypt the API keys students
# paste in Settings: the string is SHA-256'd, so any length works but only a
# genuinely random one is worth calling a secret. Set it ONCE — changing it
# makes every stored provider key undecryptable, and each student has to
# re-enter theirs.
CREDENTIAL_KEY=replace-with-a-long-random-string

# --------------------------------------------------------------------------
# Free Trial Provider (all optional — leave unset and the trial reports
# "Not switched on yet" honestly instead of pretending to work)
# --------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint, or a Google generativelanguage
# host when FREE_TRIAL_WIRE=gemini. Must be https:// with no port, query, or
# embedded credentials — anything else is rejected as an invalid Secret.
FREE_TRIAL_BASE_URL=
FREE_TRIAL_API_KEY=
FREE_TRIAL_MODEL=
# Display name students see. Falls back to FREE_TRIAL_MODEL.
FREE_TRIAL_MODEL_NAME=
# Optional model that can read textbook photos. Without it the Scanner and photo
# questions say plainly that no vision model is available.
FREE_TRIAL_VISION_MODEL=
# openai (default) or gemini. Auto-detected for googleapis.com hosts.
FREE_TRIAL_WIRE=openai
# Per-student caps, enforced from the server-side ai_usage ledger.
FREE_TRIAL_DAILY_LIMIT=20
FREE_TRIAL_TOTAL_LIMIT=200

# --------------------------------------------------------------------------
# AI routing policy (all optional — these are behaviour knobs, not secrets.
# Leave them unset and the defaults below apply; out-of-range values fall back
# to the default rather than being trusted.)
# --------------------------------------------------------------------------
# One call to the provider is cut off after this long. Range 1000–120000.
AI_TIMEOUT_MS=45000
# Attempts per model before the router moves to the next eligible one. 1–5.
# A refused key, an unknown model id or a 403 stops after one attempt: no
# retry can fix those.
AI_RETRY_ATTEMPTS=3
# Backoff before the 2nd and 3rd attempt: base doubles each time, capped by
# AI_RETRY_MAX_MS, and the whole question gives up once AI_RETRY_BUDGET_MS of
# waiting is used. Ranges 0–5000 / 0–30000 / 0–60000.
AI_RETRY_BASE_MS=500
AI_RETRY_MAX_MS=4000
AI_RETRY_BUDGET_MS=12000
# The longest Retry-After a provider is allowed to make StudyBridge wait. 0–60000.
# This caps the wait inside one question only; the provider's real number is still
# read in full to tell a busy minute apart from a spent daily allowance.
AI_RETRY_AFTER_CAP_MS=10000
# No setting here can make a retry instantaneous: 250 ms is a hard floor between
# attempts. A 429 that means "daily allowance spent" is not retried at all and is
# parked for MODEL_COOLDOWN_MAX_MS, because retrying cannot refill a quota.
# After a transient failure the model is skipped for this long, doubling per
# consecutive failure up to the max, and returns to rotation by itself on the
# next success. The model is never disabled by this. Ranges 1000–600000 /
# 5000–3600000.
MODEL_COOLDOWN_MS=30000
MODEL_COOLDOWN_MAX_MS=600000

